rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == 'salehalghmdi07@gmail.com' || 
              request.auth.token.email == 'salehalgmdi07@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidClient(data) {
      return data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() > 0 &&
             data.createdAt is string;
    }

    // Portfolio rules
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Clients rules
    match /clients/{clientId} {
      allow read: if true; // Allowed for order form lookup and admin display
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Pages rules
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Config rules
    match /site_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders rules
    match /orders/{orderId} {
      allow read, create: if true; // Public can create orders
      allow update, delete: if isAdmin();
    }

    // Services rules
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users rules (Admin profile)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
